# Copy to .env.local (git-ignored). The dashboard never holds keys; the wallet signs.
# Local sandbox (read-only dashboard): values come from .localnet/localnet.env
VITE_VAULT_ACCOUNT_ID=vault.sandbox
VITE_NEAR_RPC_URL=http://127.0.0.1:3030
VITE_SENTINEL_URL=http://127.0.0.1:8080
# Comma-separated agents to watch (the vault has no "list agents" method; agents seen in events are added too)
VITE_AGENT_IDS=agent.sandbox,agent2.sandbox
# Optional: refresh interval in ms (2000-15000) and how many past blocks to scan for events on load
# VITE_POLL_INTERVAL_MS=10000
# VITE_EVENT_LOOKBACK_BLOCKS=300
